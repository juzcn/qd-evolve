{
  "log_level": "INFO",
  "env_vars": {
    "SERPER_API_KEY": "sk-xxx",
    "BAIDU_API_KEY": "sk-xxx"
  },
  "providers": [
    {
      "name": "baiduqianfancodingplan",
      "api_key": "sk-xxx",
      "base_url": "https://qianfan.baidubce.com/v2/coding",
      "api": "openai-completions",
      "models": [
        {
          "name": "qianfan-code-latest",
          "reasoning": false,
          "input": ["text"],
          "cost": {
            "input": 0.0025,
            "output": 0.01,
            "cache_read": 0,
            "cache_write": 0
          },
          "context_window": 98304,
          "max_tokens": 65536
        }
      ]
    },
    {
      "name": "astroncodingplan",
      "api_key": "sk-xxx:sk-xxx",
      "base_url": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2",
      "api": "openai-completions",
      "models": [
        {
          "name": "astron-code-latest",
          "reasoning": false,
          "input": ["text"],
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "context_window": 92160,
          "max_tokens": 32768
        }
      ]
    }
  ],
  "default_provider": "baiduqianfancodingplan",
  "default_model": "qianfan-code-latest",
  "skills_dir": "tools/skills",
  "cli_tools_dir": "tools/cli",
  "active_skills": ["cli-register"],
  "active_tools": ["load_tool_detail", "load_skill_detail", "load_cli_detail", "recall_memory"],
  "active_cli_tools": [],
  "memory_db": "memory.db",
  "embeddings_backends": {
    "default": {
      "model_path": "BAAI/bge-m3",
      "dim": 1024,
      "backend": "sentence-transformers"
    },
    "gguf": {
      "model_path": "bge-m3-q4_k_m.gguf",
      "dim": 1024,
      "backend": "llama-cpp-python",
      "llama_n_ctx": 8192,
      "llama_n_batch": 512
    }
  },
  "memory_search": {
    "default_embeddings_backend": "default",
    "compress_threshold": 0.7,
    "target_threshold": 0.5,
    "auto_recall": true,
    "auto_recall_top_k": 5
  },
  "max_iterations": 20
}
