{
  "_note": "See README.md for full setup instructions.",
  "_llama_cpp_wheels": "CPU wheels: https://abetlen.github.io/llama-cpp-python/whl/cpu | GGUF models: https://huggingface.co",
  "log": {
    "level": "INFO",
    "truncation": 500
  },
  "env_vars": {
    "SERPER_API_KEY": "sk-xxx",
    "BAIDU_API_KEY": "sk-xxx",
    "TAVILY_API_KEY": "sk-xxx",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "providers": [
    {
      "name": "baiduqianfancodingplan",
      "api_key": "sk-xxx",
      "base_url": "https://qianfan.baidubce.com/v2/coding",
      "api": "openai-completions",
      "models": [
        {
          "name": "qianfan-code-latest",
          "reasoning": false,
          "input": ["text"],
          "cost": {
            "input": 0.0025,
            "output": 0.01,
            "cache_read": 0,
            "cache_write": 0
          },
          "context_window": 98304,
          "max_tokens": 65536
        }
      ]
    },
    {
      "name": "astroncodingplan",
      "api_key": "sk-xxx:sk-xxx",
      "base_url": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2",
      "api": "openai-completions",
      "models": [
        {
          "name": "astron-code-latest",
          "reasoning": false,
          "input": ["text"],
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "context_window": 92160,
          "max_tokens": 32768
        }
      ]
    }
  ],
  "default_provider": "baiduqianfancodingplan",
  "default_model": "qianfan-code-latest",
  "embeddings_backends": {
    "bge-m3-local": {
      "model_path": "BAAI/bge-m3",
      "dim": 1024,
      "backend": "sentence-transformers"
    },
    "bge-m3-gguf": {
      "model_path": "bge-m3-q4_k_m.gguf",
      "dim": 1024,
      "backend": "llama-cpp-python",
      "llama_n_ctx": 8192,
      "llama_n_batch": 512
    }
  },
  "memory_search": {
    "default_embeddings_backend": "bge-m3-local",
    "compress_threshold": 0.7,
    "target_threshold": 0.5,
    "auto_recall": true,
    "auto_recall_top_k": 1,
    "recall_memory_limit": 5,
    "search_by_time_limit": 20,
    "list_all_limit": 50
  },
  "max_iterations": 20,
  "tool_output_limit": 50000
}
