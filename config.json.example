{
  "_note": "Copy to config.json and fill in your API keys. See README.md for full setup instructions.",
  "log": {
    "level": "INFO",
    "truncation": 500
  },
  "env_vars": {
    "TQDM_DISABLE": "1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "providers": [
    {
      "name": "deepseek",
      "api_key": "YOUR_DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com",
      "api": "openai-completions",
      "models": [
        {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "input": [
            "text"
          ],
          "cost": {
            "input": 0.28,
            "output": 1.1,
            "cache_read": 0.07,
            "cache_write": 0.56
          },
          "context_window": 1000000,
          "max_tokens": 131072
        }
      ]
    }
  ],
  "default_provider": "deepseek",
  "default_model": "deepseek-v4-pro",
  "agents_config": {
    "chat_agent": "Jack",
    "agents": [
      {
        "name": "Jack",
        "description": "Default qd-evolve agent",
        "provider": "",
        "model": "",
        "system_prompt_template": "default",
        "memory_db": "memory.db",
        "server": {
          "host": "127.0.0.1",
          "port": 8004
        },
        "toolbox": {
          "tools": {
            "load_cli": "preload",
            "recall_memory": "preload",
            "load_skill": "preload",
            "load_func": "preload",
            "run_python": "preload",
            "run_shell": "preload",
            "install_func": "preload",
            "register_func": "preload",
            "install_skill": "preload",
            "register_skill": "preload",
            "install_mcp": "preload",
            "register_mcp": "preload"
          },
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "mqtt": {
          "username": "",
          "password": "",
          "keepalive": 60,
          "ca_certs": "",
          "certfile": "",
          "keyfile": ""
        }
      },
      {
        "name": "Sophie",
        "description": "Remote agent for cross-process A2A",
        "provider": "",
        "model": "",
        "system_prompt_template": "default",
        "memory_db": null,
        "server": {
          "host": "127.0.0.1",
          "port": 8002
        },
        "toolbox": {
          "tools": {
            "load_cli": "preload",
            "recall_memory": "preload",
            "load_skill": "preload",
            "load_func": "preload",
            "run_python": "preload",
            "run_shell": "preload"
          },
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "mqtt": {
          "username": "",
          "password": "",
          "keepalive": 60,
          "ca_certs": "",
          "certfile": "",
          "keyfile": ""
        }
      },
      {
        "name": "Jun",
        "description": "Human operator for decisions and questions",
        "provider": "human",
        "server": {
          "host": "127.0.0.1",
          "port": 8003
        },
        "mqtt": {
          "username": "",
          "password": "",
          "keepalive": 60,
          "ca_certs": "",
          "certfile": "",
          "keyfile": ""
        }
      }
    ],
    "topology": {
      "relations": [
        {
          "from": "Jack",
          "to": "Sophie",
          "mode": "peer"
        }
      ]
    },
    "a2a_cli": {
      "server": {
        "host": "127.0.0.1",
        "port": 8001
      },
      "resubscribe_retry_seconds": 15
    },
    "mqtt_broker": {
      "host": "127.0.0.1",
      "port": 1883,
      "will_delay_interval": 0
    },
    "gchat": {
      "reply_delay_min": 2.0,
      "reply_delay_max": 60.0
    }
  },
  "embeddings_backends": {
    "bge-m3-local": {
      "model_path": "BAAI/bge-m3",
      "dim": 1024,
      "backend": "sentence-transformers"
    }
  },
  "memory_search": {
    "embeddings_backend": "bge-m3-local",
    "auto_recall": false,
    "auto_recall_top_k": 1,
    "recall_memory_limit": 5,
    "list_all_limit": 50
  },
  "compress_threshold": 0.7,
  "target_threshold": 0.5,
  "max_iterations": 20,
  "tool_output_limit": 50000,
  "stream": true,
  "heartbeat_idle_seconds": 120
}
