{
  "_note": "Copy to config.json and fill in your API keys. See README.md for full setup instructions.",
  "log_level": "INFO",
  "env_vars": {
    "TQDM_DISABLE": "1",
    "SERPER_API_KEY": "YOUR_SERPER_API_KEY",
    "BAIDU_API_KEY": "YOUR_BAIDU_API_KEY",
    "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "providers": [
    {
      "name": "baiduqianfancodingplan",
      "api_key": "YOUR_BAIDU_QIANFAN_API_KEY",
      "base_url": "https://qianfan.baidubce.com/v2/coding",
      "api": "openai-completions",
      "models": [
        {
          "name": "qianfan-code-latest",
          "reasoning": false,
          "input": ["text"],
          "context_window": 98304,
          "max_tokens": 65536
        }
      ]
    },
    {
      "name": "deepseek",
      "api_key": "YOUR_DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com",
      "api": "openai-completions",
      "models": [
        {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "input": ["text"],
          "context_window": 1000000,
          "max_tokens": 131072
        },
        {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "input": ["text"],
          "context_window": 1000000,
          "max_tokens": 131072
        }
      ]
    },
    {
      "name": "astroncodingplan",
      "api_key": "YOUR_ASTRON_API_KEY",
      "base_url": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2",
      "api": "openai-completions",
      "models": [
        {
          "name": "astron-code-latest",
          "reasoning": false,
          "input": ["text"],
          "context_window": 92160,
          "max_tokens": 32768
        }
      ]
    }
  ],
  "default_provider": "deepseek",
  "default_model": "deepseek-v4-flash",
  "agents_config": {
    "chat_agent": "Jack",
    "agents": [
      {
        "name": "Jack",
        "description": "Default qd-evolve agent",
        "provider": "",
        "model": "",
        "memory_db": "memory.db",
        "server": {
          "host": "127.0.0.1",
          "port": 8004
        },
        "toolbox": {
          "tools": {
            "load_cli": "preload",
            "recall_memory": "preload",
            "load_skill": "preload",
            "load_func": "preload",
            "run_python": "preload",
            "read_file": "disabled",
            "write_file": "disabled",
            "list_directory": "disabled",
            "execute_shell_command": "disabled",
            "run_shell": "preload",
            "fetch": "disabled",
            "install_func": "preload",
            "register_func": "preload",
            "install_skill": "preload",
            "register_skill": "preload",
            "install_mcp": "preload",
            "register_mcp": "preload"
          },
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "wechat_session": null
      },
      {
        "name": "Sophie",
        "description": "Test agent for cross-process A2A",
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "memory_db": null,
        "server": {
          "host": "127.0.0.1",
          "port": 8002
        },
        "toolbox": {
          "tools": {
            "load_cli": "preload",
            "recall_memory": "preload",
            "load_skill": "preload",
            "load_func": "preload",
            "run_python": "preload",
            "read_file": "disabled",
            "write_file": "disabled",
            "list_directory": "disabled",
            "execute_shell_command": "disabled",
            "run_shell": "preload",
            "fetch": "disabled"
          },
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "wechat_session": null
      },
      {
        "name": "Jun",
        "description": "Human operator via WeChat",
        "provider": "wechat-human",
        "model": "",
        "memory_db": "memory.db",
        "server": {
          "host": "127.0.0.1",
          "port": 8003
        },
        "toolbox": {
          "tools": {},
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "wechat_session": {
          "bot_token": "YOUR_BOT_TOKEN",
          "base_url": "https://ilinkai.weixin.qq.com",
          "saved_at": 0
        }
      },
      {
        "name": "Huizi",
        "description": "Human operator via WeChat",
        "provider": "wechat-human",
        "model": "",
        "memory_db": "memory.db",
        "server": {
          "host": "127.0.0.1",
          "port": 8005
        },
        "toolbox": {
          "tools": {},
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "wechat_session": {
          "bot_token": "YOUR_BOT_TOKEN",
          "base_url": "https://ilinkai.weixin.qq.com",
          "saved_at": 0
        }
      },
      {
        "name": "Freud",
        "description": "Human",
        "provider": "human",
        "model": "",
        "memory_db": "memory.db",
        "server": {
          "host": "127.0.0.1",
          "port": 8006
        },
        "toolbox": {
          "tools": {},
          "mcp_servers": {},
          "bridge": {},
          "cli": {},
          "skills": {}
        },
        "wechat_session": null
      }
    ],
    "a2a_cli": {
      "server": {
        "host": "127.0.0.1",
        "port": 8001
      }
    },
    "mqtt_broker": {
      "host": "127.0.0.1",
      "port": 1883
    },
    "gchat": {
      "reply_delay_min": 2.0,
      "reply_delay_max": 60.0
    }
  },
  "embeddings_backends": {
    "bge-m3-local": {
      "model_path": "BAAI/bge-m3",
      "backend": "sentence-transformers"
    },
    "bge-m3-gguf": {
      "model_path": "path/to/bge-m3-q4_k_m.gguf",
      "backend": "llama-cpp-python"
    }
  },
  "memory_search": {
    "embeddings_backend": "bge-m3-local",
    "auto_recall": false,
    "auto_recall_top_k": 1,
    "recall_memory_limit": 5,
    "list_all_limit": 50
  },
  "max_iterations": 20,
  "stream": true,
  "heartbeat_idle_seconds": 60
}
