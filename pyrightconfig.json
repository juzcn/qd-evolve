{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/package.json",

  // ── Scope ───────────────────────────────────────────────────────
  "include": ["qd_evolve", "tests"],
  "exclude": [
    ".venv",
    "**/__pycache__",
    "**/node_modules",
    ".git",
    "*.pyc"
  ],

  // ── Environment ─────────────────────────────────────────────────
  "pythonVersion": "3.13",
  "pythonPlatform": "All",
  "venvPath": ".",
  "venv": ".venv",

  // ── Type checking: "basic" | "standard" | "strict" ──────────────
  // standard = basic + extra ~50% rules (unused vars, type-is, etc.)
  "typeCheckingMode": "standard",

  // ── Rule overrides (applied on top of typeCheckingMode) ─────────
  "reportMissingTypeStubs": "none",
  "reportPrivateUsage": "none",

  // Uncomment to temporarily suppress noisy categories during cleanup:
  // "reportUnknownMemberType": "none",
  // "reportUnknownVariableType": "none",
  // "reportUnknownArgumentType": "none",
  // "reportMissingParameterType": "none",
  // "reportUnknownParameterType": "none",

  // Tests: don't need full strictness
  "executionEnvironments": [
    {
      "root": "tests",
      "reportUnknownMemberType": "none",
      "reportMissingParameterType": "none",
      "reportUnknownArgumentType": "none"
    }
  ]
}
